# Copiar este archivo como ".env" (en esta misma carpeta).
# Create React App solo lee variables que empiezan con REACT_APP_
# y las lee al iniciar: después de cambiarlas hay que reiniciar "npm start".

# URL base de la API (sin "/" al final).
# En producción: la URL que dé Render.
REACT_APP_API_URL=http://localhost:3001
