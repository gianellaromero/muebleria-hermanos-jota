# Copiar este archivo como ".env" (en esta misma carpeta) y completar los valores.
# El archivo .env NO se sube a GitHub: contiene datos privados.

# Puerto de la API (React usa el 3000)
PORT=3001

# Cadena de conexión de MongoDB Atlas (la configura el integrante 1)
MONGODB_URI=

# Frontends que pueden usar la API (CORS). Si son varios, separarlos con coma.
# En producción: la URL de Vercel/Netlify.
FRONTEND_URL=http://localhost:3000
